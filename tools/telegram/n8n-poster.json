      "parameters": {
        "resource": "request",
        "request_json": "={{ JSON.stringify({ _: 'sendMessage', chat_id: $('Find channel').item.json.id, input_message_content: { _: 'inputMessagePhoto', photo: { _: 'inputFileLocal', path: $('Pick next event').item.json.path }, width: $('Pick next event').item.json.width, height: $('Pick next event').item.json.height, added_sticker_file_ids: [], caption: { _: 'formattedText', text: $('Format caption').item.json.text, entities: $('Format caption').item.json.entities } } }) }}"
      },
      "credentials": {
        "telePilotApi": {
          "id": "hg0ym3b81VExWu22",
          "name": "Personal Telegram CoPilot account"
        }
      }
    },
