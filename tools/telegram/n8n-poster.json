      "name": "Pick next event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "jsCode": "// Next event in timeline order that hasn't been posted yet. Nothing left → stop quietly.\nconst manifest = $('Fetch manifest').first().json;\nconst posted = new Set($input.all().map((i) => i.json.slug).filter(Boolean));\nconst next = manifest.items.find((it) => !posted.has(it.slug));\nif (!next) return [];\nreturn [{ json: {\n  ...next,\n  channel: manifest.channel,\n  // Local copy for TDLib to upload. n8n may only write under ~/.n8n-files\n  // (mounted from ~/n8n/n8n_files on the host).\n  path: `/home/node/.n8n-files/thegreatdevil-${next.slug}.jpg`,\n  trigger: $('Schedule').isExecuted ? 'schedule' : 'post-now',\n} }];"
      }
    },
    {
      "id": "a6",
      "name": "Download poster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "url": "={{ $json.poster }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "a7",
