        1440,
        100
      ],
      "parameters": {
        "resource": "request",
        "request_json": "={{ JSON.stringify({ _: 'searchPublicChat', username: $('Pick next event').item.json.channel }) }}"
      },
      "credentials": {
        "telePilotApi": {
          "id": "hg0ym3b81VExWu22",
          "name": "Personal Telegram CoPilot account"
        }
      }
    },
    {
